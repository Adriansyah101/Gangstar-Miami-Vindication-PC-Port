# ---------------------------------------------------------------------------
# GangstarMV Win32 host -- what NOT to commit.
# Commit: host/ (minus app.ico), tools/*.py, docs/, README.md, CHANGELOG.md, CHANGELOG_old.md, FIXES.txt, .gitignore.
# ---------------------------------------------------------------------------

# Build outputs -- all regenerated by host/build.ps1 and tools/genlow.py
# (GangstarMV.exe, gmv_patch.bin, cache\GangstarMV.log, gmv_link*.bin).
/build/
/test/
*.log

# SDL3, fetched by tools/get_sdl3.ps1
/host/third_party/

# Python tool caches
__pycache__/
*.pyc

# The game itself is copyrighted (Gameloft) -- never commit it. It lives INSIDE the
# project root as GangstarMV.app/ (next to host/, build/, tools/, analysis/), so it
# must be ignored explicitly. The patterns below also guard against a stray copy of
# the Mach-O binary or an old extracted/ folder being added by accident.
/GangstarMV.app/
*.app/
GangstarMV
extracted/
*.ipa
*.dylib
*.rar
*.7z
*.zip

# Other builds of the game and Gameloft's other game, kept next to the project for reference.
/Gangstar Miami Vindication HD Ipad/
/Gangstar Miami Vindication Iphone/
/Urban Crime iOS/

# Analysis dumps -- derived from the game binary (symbols, addresses, ObjC metadata) and
# regenerated by the tools, so they stay local.
/analysis/

# Sound samples extracted from the game's packs -- copyrighted game audio, never commit.
/extracted_audio/
*.wav
*.pcm

# Icon art taken from the game's .icns (Gameloft) -- the game's app.rc builds without it.
/App icon.png
/host/games/*/app.ico

# Diagnostic framebuffer captures (GMV_DUMP_FRAME); written in the game's cwd (project root).
gmv_frame.bmp
*.bmp

# Milestone screenshots are the game's copyrighted art (Gameloft) -- keep locally for
# reference, but never commit them. Remove this line only if you intend to publish them.
/screenshots/

# Editor / OS junk
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
